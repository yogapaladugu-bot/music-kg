# Large source dumps and generated import data must not be committed.
data/raw/
data/processed/
# Edge extraction writes reproducible intermediate JSONL here. It can be
# regenerated from the raw MusicBrainz archive, so Git should ignore it too.
data/staged/
data/snapshots/*.sgsnap

# Rust compilation output for the recovered Samyama source is large and can
# always be regenerated. Keep the readable source, never the build cache.
vendor/samyama-graph/target/
